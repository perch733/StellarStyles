{
  "name": "stellarstyles.css",
  "version": "1.1.8",
  "description": "Alternative to normalize.css",
  "main": "dist/stellarstyles.min.css",
  "types": "./dist/stellarstyles.d.ts",
  "exports": {
    ".": {
      "types": "./dist/stellarstyles.d.ts",
      "default": "./dist/stellarstyles.min.css"
    },
    "./selection": {
      "types": "./dist/selection.d.ts",
      "default": "./dist/selection.min.css"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE.md"
  ],
  "author": "Percy Chuzon <contacto@percychuzon.com>",
  "license": "MIT",
  "scripts": {
    "build:css": "postcss src/stellarStyles.css -o dist/stellarstyles.min.css --no-map",
    "build:selection": "postcss src/selection.css -o dist/selection.min.css --no-map",
    "build:types": "shx cp src/*.d.ts dist/",
    "build": "npm run build:css && npm run build:selection && npm run build:types"
  },
  "keywords": [
    "normalize.css",
    "reset",
    "css-reset",
    "CSS resets",
    "reset.css",
    "normalize",
    "standardize.css",
    "modern-normalize",
    "sanitize.css",
    "minimal-css",
    "css-baseline",
    "typography",
    "default-styles",
    "design-system",
    "postcss",
    "starter-styles",
    "frontend",
    "ui-framework",
    "cross-browser"
  ],
  "homepage": "https://stellarstyles.percychuzon.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perch733/StellarStyles.git"
  },
  "bugs": {
    "url": "https://github.com/perch733/StellarStyles/issues"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {}
}
